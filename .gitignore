# ===== Swift (Swift Package Manager, VS Code) =====
.build/
.swiftpm/
*.o
*.swiftmodule
*.swiftdoc
# Keep Package.resolved committed so dependency versions stay consistent

# ===== VS Code =====
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace
.history/

