.gradle/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
app/release/
*.apk
*.aab

# ===== Secrets & signing keys (never commit these) =====
.env
.env.*
secrets.*
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision
GoogleService-Info.plist
google-services.json

